{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "ListTheBucketIncludingVersions",
			"Effect": "Allow",
			"Action": [
				"s3:ListBucket",
				"s3:ListBucketVersions",
				"s3:GetBucketLocation",
				"s3:ListBucketMultipartUploads"
			],
			"Resource": "arn:aws:s3:::__BUCKET__"
		},
		{
			"Sid": "FullObjectControlAndGlacierRestore",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:DeleteObject",
				"s3:RestoreObject",
				"s3:ListMultipartUploadParts",
				"s3:AbortMultipartUpload"
			],
			"Resource": "arn:aws:s3:::__BUCKET__/*"
		}
	]
}
