<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.copyparty</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/sbin/copyparty-server.sh</string>
	</array>

	<!-- A LaunchDaemon so it is back before anyone logs in; this machine has
	     no auto-login. Runs as fabigato, who owns tank/documents. -->
	<key>UserName</key>
	<string>fabigato</string>
	<key>GroupName</key>
	<string>staff</string>

	<key>RunAtLoad</key>
	<true/>

	<!-- Unconditional, as for Jellyfin: a nonzero exit means "the pool was not
	     there", which fixes itself when the enclosure comes back. -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>

	<key>ProcessType</key>
	<string>Adaptive</string>

	<!-- launchd's PATH lacks /opt/homebrew/bin; copyparty finds ffmpeg (video
	     thumbnails) through PATH. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>4096</integer>
	</dict>

	<!-- NO StandardOutPath / StandardErrorPath, deliberately.

	     Request logs go to /usr/local/var/log/copyparty/ via `lo` in the config,
	     and the config sets `q`, so copyparty's console only carries startup
	     errors and crashes. The wrapper captures that into
	     /usr/local/var/log/copyparty-server/console.log and writes its own guard
	     messages to wrapper.log beside it.

	     Why the wrapper and not launchd, at length in local.jellyfin.plist; the
	     short version is that launchd opens StandardOutPath as the job's user
	     before exec, so a missing file under a parent that user cannot write is an
	     unrecoverable EX_CONFIG (78) spawn failure with nothing logged to explain
	     it. Something swept /var/log around the macOS 27.2.1 update on 2026-11-20
	     and that is exactly what happened to this daemon, to Jellyfin and to the
	     LM Studio daemon. /var/log is root:wheel 0755, so moving the files into a
	     fabigato-owned directory under it (commit 7dc0ca0) fixed the files but not
	     the directory.

	     Everything is under /usr/local/var/log now: owned fabigato:staff, outside
	     what the macOS installer manages, and `mkdir -p`'d by the wrapper on every
	     start. With no log path in this plist, broken logging degrades logging
	     instead of taking the service down. -->

	<key>WorkingDirectory</key>
	<string>/usr/local/var/copyparty</string>
</dict>
</plist>
